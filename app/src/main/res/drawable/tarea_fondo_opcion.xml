<?xml version="1.0" encoding="utf-8"?>
<!-- Este selector muestra qué intervalo o momento del día está elegido. -->
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- state_checked se cumple cuando un RadioButton es la opción elegida. -->
    <item
        android:state_checked="true">

        <!-- El relleno melocotón destaca la elección sin añadir un círculo separado. -->
        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/melocoton" />

            <stroke
                android:width="1dp"
                android:color="@color/melocoton" />

            <corners
                android:radius="12dp" />

        </shape>

    </item>

    <!-- Al pulsar se ilumina el control para confirmar el toque. -->
    <item
        android:state_pressed="true">

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/agenda_melocoton_suave" />

            <stroke
                android:width="1dp"
                android:color="@color/ciruela" />

            <corners
                android:radius="12dp" />

        </shape>

    </item>

    <!-- El borde también permite ver el control elegido mediante teclado. -->
    <item
        android:state_focused="true">

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/fondo_campo" />

            <stroke
                android:width="2dp"
                android:color="@color/ciruela" />

            <corners
                android:radius="12dp" />

        </shape>

    </item>

    <!-- Una opción sin seleccionar mantiene el relleno claro y el borde fino. -->
    <item>

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/fondo_campo" />

            <stroke
                android:width="1dp"
                android:color="@color/borde_campo" />

            <corners
                android:radius="12dp" />

        </shape>

    </item>

</selector>
