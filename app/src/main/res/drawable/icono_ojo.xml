<?xml version="1.0" encoding="utf-8"?>
<!-- Este vector dibuja el ojo abierto del botón de contraseña. estado_ojo_contrasena.xml lo muestra cuando el usuario puede pulsar para ver lo que escribió. -->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- path dibuja el ojo con interior transparente. Las líneas redondeadas toman el color ciruela de colores.xml. -->
    <path
        android:fillColor="@color/transparente"
        android:strokeColor="@color/ciruela"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M2,12Q12,-1 22,12Q12,25 2,12ZM15.5,12a3.5,3.5 0,1 0,-7 0a3.5,3.5 0,0 0,7 0Z" />

</vector>
