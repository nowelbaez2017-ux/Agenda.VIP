<?xml version="1.0" encoding="utf-8"?>
<!-- ripple hace aparecer una onda al tocar enlaces y botones de navegación, como Volver o las opciones inferiores de la agenda. -->
<ripple
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/onda_ciruela">

    <!-- mask limita la onda al rectángulo redondeado de este botón. -->
    <item
        android:id="@android:id/mask">

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/ciruela" />

            <!-- @dimen/radio_campo toma de dimensiones.xml cuánto se redondean las esquinas. -->
            <corners
                android:radius="@dimen/radio_campo" />

        </shape>

    </item>

</ripple>
