<?xml version="1.0" encoding="utf-8"?>
<!-- shape dibuja la tarjeta con fondo claro, borde fino y esquinas redondeadas. -->
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- solid rellena el interior con el mismo tono que los campos de la agenda. -->
    <solid
        android:color="@color/fondo_campo" />

    <!-- stroke delimita el grupo sin proyectar sombra. -->
    <stroke
        android:width="1dp"
        android:color="@color/borde_campo" />

    <!-- corners redondea las cuatro esquinas. -->
    <corners
        android:radius="16dp" />

</shape>
