<?xml version="1.0" encoding="utf-8"?>
<!-- selector elige el fondo según el estado del botón; el filtro activo usa melocotón. -->
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El filtro elegido tiene un fondo suave y un borde fino. -->
    <item
        android:state_selected="true">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/melocoton" />
            <corners
                android:radius="10dp" />
        </shape>
    </item>

    <!-- Al tocar un filtro todavía no elegido se ve una respuesta breve al toque. -->
    <item
        android:state_pressed="true">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/agenda_melocoton_suave" />
            <corners
                android:radius="10dp" />
        </shape>
    </item>

    <!-- El resto conserva el fondo marfil y solo una línea de contorno. -->
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/marfil" />
            <stroke
                android:width="1dp"
                android:color="@color/borde_campo" />
            <corners
                android:radius="10dp" />
        </shape>
    </item>

</selector>
