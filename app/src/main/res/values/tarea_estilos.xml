<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        resources reúne los estilos del formulario de tareas. Un style agrupa medidas,
        colores y fondos; cada item asigna una propiedad. El diseño los usa con @style.
        dp mide espacios y sp respeta el tamaño de letra elegido en el teléfono.
    -->

    <!-- Este estilo presenta las preguntas del formulario con una letra clara de color ciruela. -->
    <style
        name="TareaEtiqueta">

        <item
            name="android:layout_width">match_parent</item>

        <item
            name="android:layout_height">wrap_content</item>

        <item
            name="android:layout_marginTop">12dp</item>

        <item
            name="android:layout_marginBottom">5dp</item>

        <item
            name="android:fontFamily">serif</item>

        <item
            name="android:textSize">16sp</item>

        <item
            name="android:textColor">@color/ciruela</item>

    </style>

    <!-- Esta variante elimina el margen superior para alinear Fecha, Hora y Momento. -->
    <style
        name="TareaEtiquetaCompacta"
        parent="TareaEtiqueta">

        <item
            name="android:layout_marginTop">0dp</item>

        <item
            name="android:textSize">15sp</item>

    </style>

    <!-- Los textos pequeños explican el formato o el funcionamiento de cada opción. -->
    <style
        name="TareaAyuda">

        <item
            name="android:layout_width">match_parent</item>

        <item
            name="android:layout_height">wrap_content</item>

        <item
            name="android:textColor">@color/texto_secundario</item>

        <item
            name="android:textSize">12sp</item>

    </style>

    <!--
        Los EditText usan un borde fino, fondo marfil y separación interior.
        El fondo propio de tareas evita cambiar los campos de las pantallas de acceso.
    -->
    <style
        name="TareaCampo">

        <item
            name="android:layout_width">match_parent</item>

        <item
            name="android:layout_height">wrap_content</item>

        <item
            name="android:minHeight">48dp</item>

        <item
            name="android:minWidth">0dp</item>

        <item
            name="android:paddingStart">10dp</item>

        <item
            name="android:paddingTop">10dp</item>

        <item
            name="android:paddingEnd">10dp</item>

        <item
            name="android:paddingBottom">10dp</item>

        <item
            name="android:fontFamily">serif</item>

        <item
            name="android:textSize">16sp</item>

        <item
            name="android:textColor">@color/ciruela</item>

        <item
            name="android:textColorHint">@color/texto_secundario</item>

        <item
            name="android:background">@drawable/tarea_fondo_campo</item>

        <item
            name="android:backgroundTint">@null</item>

    </style>

    <!-- La fecha y la hora usan menos separación lateral para caber en una fila. -->
    <style
        name="TareaCampoCompacto"
        parent="TareaCampo">

        <item
            name="android:paddingStart">8dp</item>

        <item
            name="android:paddingEnd">8dp</item>

    </style>

    <!-- Los botones de repetición y música mantienen el mismo borde que los campos. -->
    <style
        name="TareaBoton"
        parent="android:style/Widget.Material.Button">

        <item
            name="android:layout_width">match_parent</item>

        <item
            name="android:layout_height">wrap_content</item>

        <item
            name="android:minHeight">48dp</item>

        <item
            name="android:minWidth">0dp</item>

        <item
            name="android:textAllCaps">false</item>

        <item
            name="android:textColor">@color/ciruela</item>

        <item
            name="android:fontFamily">serif</item>

        <item
            name="android:textSize">16sp</item>

        <item
            name="android:gravity">center_vertical|start</item>

        <item
            name="android:padding">10dp</item>

        <item
            name="android:background">@drawable/tarea_fondo_campo</item>

        <item
            name="android:backgroundTint">@null</item>

    </style>

    <!--
        Las opciones de RadioGroup parecen botones pequeños.
        button oculta el círculo original; el fondo melocotón señala la opción elegida.
        La altura puede crecer con la letra y nunca recorta el texto en una sola línea.
    -->
    <style
        name="TareaOpcion">

        <item
            name="android:layout_width">wrap_content</item>

        <item
            name="android:layout_height">wrap_content</item>

        <item
            name="android:minHeight">48dp</item>

        <item
            name="android:minWidth">48dp</item>

        <item
            name="android:button">@null</item>

        <item
            name="android:gravity">center</item>

        <item
            name="android:fontFamily">serif</item>

        <item
            name="android:textSize">15sp</item>

        <item
            name="android:textColor">@color/ciruela</item>

        <item
            name="android:paddingStart">7dp</item>

        <item
            name="android:paddingTop">10dp</item>

        <item
            name="android:paddingEnd">7dp</item>

        <item
            name="android:paddingBottom">10dp</item>

        <item
            name="android:background">@drawable/tarea_fondo_opcion</item>

        <item
            name="android:backgroundTint">@null</item>

    </style>

    <!-- Cada interruptor muestra el título de su sección y el color de su estado. -->
    <style
        name="TareaInterruptor">

        <item
            name="android:layout_width">match_parent</item>

        <item
            name="android:layout_height">wrap_content</item>

        <item
            name="android:minHeight">48dp</item>

        <item
            name="android:fontFamily">serif</item>

        <item
            name="android:textSize">20sp</item>

        <item
            name="android:textColor">@color/ciruela</item>

        <item
            name="android:switchPadding">8dp</item>

        <item
            name="android:thumbTint">@color/marfil</item>

        <item
            name="android:trackTint">@color/tarea_interruptor_pista</item>

    </style>

    <!-- Una línea fina separa secciones sin añadir tarjetas ni fondos grandes. -->
    <style
        name="TareaSeparador">

        <item
            name="android:layout_width">match_parent</item>

        <item
            name="android:layout_height">1dp</item>

        <item
            name="android:layout_marginTop">14dp</item>

        <item
            name="android:layout_marginBottom">3dp</item>

        <item
            name="android:background">@color/borde_campo</item>

    </style>

    <!-- Guardar usa melocotón y texto ciruela como la referencia Opción 1. -->
    <style
        name="TareaGuardar"
        parent="TareaBoton">

        <item
            name="android:gravity">center</item>

        <item
            name="android:textSize">18sp</item>

        <item
            name="android:textStyle">bold</item>

        <item
            name="android:background">@drawable/tarea_fondo_guardar</item>

    </style>

</resources>
