<?xml version="1.0" encoding="utf-8"?>
<!-- ripple muestra una onda al tocar el ojo de la contraseña o el avatar de la agenda, para que la pulsación sea visible. -->
<ripple
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/onda_ciruela">

    <!-- mask limita hasta dónde se dibuja la onda. Este identificador pertenece a Android y se usa aquí para darle forma circular. -->
    <item
        android:id="@android:id/mask">

        <!-- shape crea una forma; oval hace que la zona de la pulsación sea redonda. -->
        <shape
            android:shape="oval">

            <solid
                android:color="@color/ciruela" />

        </shape>

    </item>

</ripple>
