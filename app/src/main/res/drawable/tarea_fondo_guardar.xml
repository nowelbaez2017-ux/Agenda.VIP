<?xml version="1.0" encoding="utf-8"?>
<!-- Este selector cambia ligeramente el botón Guardar cuando recibe el toque. -->
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El borde ciruela señala la pulsación manteniendo el color melocotón. -->
    <item
        android:state_pressed="true">

        <!-- shape dibuja el botón redondeado; el texto se define en tarea_estilos.xml. -->
        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/melocoton" />

            <stroke
                android:width="2dp"
                android:color="@color/ciruela" />

            <corners
                android:radius="24dp" />

        </shape>

    </item>

    <!-- Este es el estado habitual del botón principal del formulario. -->
    <item>

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/melocoton" />

            <corners
                android:radius="24dp" />

        </shape>

    </item>

</selector>
