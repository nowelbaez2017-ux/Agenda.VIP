<?xml version="1.0" encoding="utf-8"?>
<!-- Este vector dibuja el ojo tachado del botón de contraseña. estado_ojo_contrasena.xml lo muestra cuando pulsarlo volverá a ocultar el texto. -->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- pathData dibuja tanto el ojo como la línea diagonal que lo cruza. -->
    <path
        android:fillColor="@color/transparente"
        android:strokeColor="@color/ciruela"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,3L21,21M9,4.8Q16,3 22,12Q20.2,14.4 18,16M6,6Q3.8,8.4 2,12Q9,21 16,18M9.5,9.5a3.5,3.5 0,0 0,5 5" />

</vector>
