<?xml version="1.0" encoding="utf-8"?>
<!-- layer-list coloca dos círculos uno encima de otro para formar el aro suave del avatar. -->
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item>

        <shape
            android:shape="oval">

            <solid
                android:color="@color/perfil_avatar_exterior" />

        </shape>

    </item>

    <!-- El segundo círculo deja 12dp alrededor para que pueda verse el aro exterior. -->
    <item
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp">

        <shape
            android:shape="oval">

            <solid
                android:color="@color/perfil_avatar_interior" />

        </shape>

    </item>

</layer-list>
