<?xml version="1.0" encoding="utf-8"?>
<!-- ripple marca visualmente el toque del botón sin alterar su tamaño. -->
<ripple
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/onda_ciruela">

    <!-- El relleno lavanda distingue el botón de las notas y campos del formulario. -->
    <item>
        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/perfil_etiqueta_fondo" />

            <corners
                android:radius="12dp" />

        </shape>
    </item>

</ripple>
