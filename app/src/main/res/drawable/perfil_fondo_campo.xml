<?xml version="1.0" encoding="utf-8"?>
<!-- selector cambia el borde del campo cuando recibe el foco, es decir, cuando está listo para escribir. -->
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:state_focused="true">

        <!-- shape dibuja un rectángulo; solid rellena, stroke marca el borde y corners redondea. -->
        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/fondo_campo" />

            <stroke
                android:width="1dp"
                android:color="@color/ciruela" />

            <corners
                android:radius="9dp" />

        </shape>

    </item>

    <item>

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/fondo_campo" />

            <stroke
                android:width="1dp"
                android:color="@color/borde_campo" />

            <corners
                android:radius="9dp" />

        </shape>

    </item>

</selector>
