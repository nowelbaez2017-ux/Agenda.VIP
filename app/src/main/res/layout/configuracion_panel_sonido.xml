<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView permite recorrer el cuadro incluso con letra grande o con el teléfono de lado. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Esta columna reúne las opciones de voz y volumen del mismo aviso. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp">

        <!-- Button abre la lista de voces locales. Su texto incluye la voz elegida. -->
        <Button
            android:id="@+id/cuenta_elegir_voz"
            style="@style/ConfiguracionAccionPanel" />

        <!-- TextView indica el valor de la barra y se actualiza mientras se mueve. -->
        <TextView
            android:id="@+id/cuenta_porcentaje_volumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/cuenta_volumen"
            android:textColor="@color/ciruela"
            android:textSize="16sp" />

        <!-- SeekBar permite ajustar el volumen propio de los avisos con el dedo o el teclado. -->
        <SeekBar
            android:id="@+id/cuenta_volumen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="100"
            android:progressTint="@color/ciruela"
            android:thumbTint="@color/ciruela"
            android:contentDescription="@string/configuracion_volumen" />

        <!-- La muestra reproduce una frase usando los ajustes elegidos en este cuadro. -->
        <Button
            android:id="@+id/cuenta_escuchar_voz"
            style="@style/ConfiguracionAccionPanel"
            android:drawableStart="@drawable/tarea_icono_escuchar"
            android:drawableEnd="@null"
            android:text="@string/configuracion_escuchar" />

    </LinearLayout>

</ScrollView>
