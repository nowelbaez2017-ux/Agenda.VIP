<?xml version="1.0" encoding="utf-8"?>
<!-- selector oscurece el botón Guardar cambios cuando se pulsa para confirmar el contacto. -->
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:state_pressed="true">

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/perfil_guardar_presionado" />

            <corners
                android:radius="24dp" />

        </shape>

    </item>

    <item>

        <shape
            android:shape="rectangle">

            <solid
                android:color="@color/melocoton" />

            <corners
                android:radius="24dp" />

        </shape>

    </item>

</selector>
